# Supabase: use el connection string de Transaction pooler para la app en Vercel.
# Codifique caracteres especiales de la contraseña para URL (por ejemplo @ como %40).
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase: URL directa para Prisma Migrate. Si la conexión directa no está
# disponible en su red, use el Session pooler (puerto 5432).
DIRECT_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres"

# Contraseña inicial del administrador (mínimo 12 caracteres recomendado).
ADMIN_PASSWORD="reemplazar-por-una-clave-segura"

# Secreto aleatorio de al menos 32 caracteres para firmar sesiones.
JWT_SECRET="reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres"
TZ="America/Lima"
